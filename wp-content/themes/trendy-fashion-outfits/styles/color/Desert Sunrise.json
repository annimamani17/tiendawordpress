{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "title": "Desert Sunrise",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "color": "#4b3b2e", "name": "Foreground", "slug": "foreground" },
        { "color": "#e27d60", "name": "Primary", "slug": "primary" },
        { "color": "#c38d9e", "name": "Secondary", "slug": "secondary" },
        { "color": "#fff5f0", "name": "Background", "slug": "background" },
        { "color": "#5c5c5c", "name": "Body Text", "slug": "body-text" },
        { "color": "#f6e0d4", "name": "Secondary Background", "slug": "background-secondary" },
        { "color": "#f1c1a0", "name": "Soft Sand", "slug": "soft-sand" },
        { "color": "#f9e5d9", "name": "Desert White", "slug": "desert-white" }
      ],
      "gradients": [
        { "gradient": "linear-gradient(135deg, #e27d60 0%, #c38d9e 100%)", "name": "Primary Gradient", "slug": "primary-gradient" },
        { "gradient": "linear-gradient(277deg, #f6e0d4 0%, #f9e5d9 100%)", "name": "Secondary Gradient", "slug": "secondary-gradient" }
      ]
    }
  }
}
