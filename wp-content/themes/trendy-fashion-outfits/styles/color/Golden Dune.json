{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "title": "Golden Dune",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "color": "#3e2f2a", "name": "Foreground", "slug": "foreground" },
        { "color": "#f4d35e", "name": "Primary", "slug": "primary" },
        { "color": "#e6b89c", "name": "Secondary", "slug": "secondary" },
        { "color": "#fffaf0", "name": "Background", "slug": "background" },
        { "color": "#5c5c5c", "name": "Body Text", "slug": "body-text" },
        { "color": "#f9e6c1", "name": "Secondary Background", "slug": "background-secondary" },
        { "color": "#ffe0a3", "name": "Soft Sand", "slug": "soft-sand" },
        { "color": "#fff2d8", "name": "Desert White", "slug": "desert-white" }
      ],
      "gradients": [
        { "gradient": "linear-gradient(135deg, #f4d35e 0%, #e6b89c 100%)", "name": "Primary Gradient", "slug": "primary-gradient" },
        { "gradient": "linear-gradient(277deg, #f9e6c1 0%, #fff2d8 100%)", "name": "Secondary Gradient", "slug": "secondary-gradient" }
      ]
    }
  }
}
